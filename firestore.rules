rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate generic string IDs
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection testing
    match /test/{testId} {
      allow read, write: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Services
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isValidId(serviceId);
    }

    // Sales transactions
    match /sales/{saleId} {
      allow read: if true;
      allow write: if isValidId(saleId);
    }

    // Store settings
    match /storeSettings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }
  }
}
